---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import SocialIcons from '@/components/SocialIcons.astro'
import AvatarComponent from '@/components/ui/avatar'
import { SITE, SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="About" description={SITE.DESCRIPTION}>
  <Container class="mb-8">
    <Breadcrumbs items={[{ label: 'About' }]} />
  </Container>
  <div class="mx-auto max-w-screen-lg px-4">
    <div
      class="grid min-h-[calc(100vh-300px)] grid-cols-1 gap-8 lg:grid-cols-3"
    >
      <aside
        class="flex flex-col items-center justify-center gap-4 rounded-xl bg-secondary/50 p-6"
      >
        <AvatarComponent
          client:load
          src="/static/face.jpg"
          alt="Philip Dobranowski"
          fallback="PD"
          className="size-40 rounded-full lg:size-48"
        />
        <h2 class="text-2xl font-bold">Philip Dobranowski</h2>
        <p class="text-center text-md text-muted-foreground">
          CS | Systems Security | SWE
        </p>
        <SocialIcons links={SOCIAL_LINKS} className="mt-1" />
      </aside>
      <main
        class="prose col-span-1 max-w-none rounded-xl bg-secondary/50 p-6 dark:prose-invert lg:col-span-2 lg:p-8"
      >
        <p>
          Hi! I'm Philip, also known as Rench online. I'm currently an undergrad
          at Georgia Tech studying Computer Science with a concentration in
          Systems & Architecture and Networking.
        </p>
        <p>
          I spend most of my time in systems security with some
          engineering work on the side. Outside of that, I enjoy
          weightlifting, drawing, and traveling.
        </p>
        <p>
          I got into cybersecurity through Capture-the-Flag competitions (CTFs).
          I currently play with the teams <Link
          href="https://ctftime.org/team/222911" underline class="text-primary"
          external>.;,;.</Link> and <Link
          href="https://ctftime.org/team/220769" underline class="text-primary"
          external>FMC</Link>, focusing on binary exploitation and reverse
          engineering. I am also involved in security research and I'm
          particularly interested in combining traditional security tools with
          LLMs.
        </p>
        <p>
          Feel free to check out my <Link href="/blog" underline
          class="text-primary">blog</Link>, where I mainly post CTF writeups as
          well as other random tidbits.
        </p>
      </main>
    </div>
  </div>
</Layout>
